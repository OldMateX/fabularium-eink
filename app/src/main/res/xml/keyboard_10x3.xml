<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:horizontalGap="0.45%p"
    app:keyHeight="50dp"
    app:keyWidth="9.4%p"
    app:verticalGap="0.45%p">

    <!-- Row 1: 10 keys x 9.4% + 11 gaps x 0.45% = 99.95% -->
    <Row>
        <Key app:codes="1" app:keyEdgeFlags="left" app:keyLabel="GET" />
        <Key app:codes="2" app:keyLabel="DROP" />
        <Key app:codes="3" app:keyLabel="OPEN" />
        <Key app:codes="4" app:keyLabel="CLOSE" />
        <Key app:codes="5" app:keyLabel="EXAM" />
        <Key app:codes="6" app:keyLabel="TALK" />
        <Key app:codes="7" app:keyLabel="TAKE" />
        <Key app:codes="8" app:keyLabel="⇖" />
        <Key app:codes="9" app:keyLabel="⇑" />
        <Key app:codes="10" app:keyEdgeFlags="right" app:keyLabel="⇗" />
    </Row>

    <!-- Row 2: 10 keys x 9.4% + 11 gaps x 0.45% = 99.95% -->
    <Row>
        <Key app:codes="11" app:keyEdgeFlags="left" app:keyLabel="X" />
        <Key app:codes="12" app:keyLabel="GIVE" />
        <Key app:codes="13" app:keyLabel="PUT" />
        <Key app:codes="14" app:keyLabel="MOVE" />
        <Key app:codes="15" app:keyLabel="TURN" />
        <Key app:codes="16" app:keyLabel="PUSH" />
        <Key app:codes="17" app:keyLabel="PULL" />
        <Key app:codes="18" app:keyLabel="⇐" />
        <Key app:codes="19" app:keyLabel="WAIT" />
        <Key app:codes="20" app:keyEdgeFlags="right" app:keyLabel="⇒" />
    </Row>

    <!-- Row 3: 10 keys x 9.4% + 11 gaps x 0.45% = 99.95% -->
    <Row app:rowEdgeFlags="bottom">
        <Key app:codes="21" app:keyEdgeFlags="left" app:keyLabel="EAT" />
        <Key app:codes="22" app:keyLabel="READ" />
        <Key app:codes="23" app:keyLabel="WAVE" />
        <Key app:codes="24" app:keyLabel="HIT" />
        <Key app:codes="25" app:keyLabel="USE" />
        <Key app:codes="26" app:keyLabel="UNDO" />
        <Key app:codes="27" app:keyLabel="SCORE" />
        <Key app:codes="28" app:keyLabel="⇙" />
        <Key app:codes="29" app:keyLabel="⇓" />
        <Key app:codes="30" app:keyEdgeFlags="right" app:keyLabel="⇘" />
    </Row>

</Keyboard>   