<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fabularium" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window -->
        <item name="android:windowBackground">#121212</item>
        <item name="android:popupBackground">#121212</item>

        <!-- Toolbar: white bg, black text -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>

        <!-- Accent -->
        <item name="colorAccent">#FFFFFF</item>

        <!-- Content area: explicitly pin all surface tokens -->
        <item name="colorBackground">#121212</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2D2D2D</item>
        <item name="colorOnSurfaceVariant">#BDBDBD</item>
        <item name="android:colorBackground">#121212</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BDBDBD</item>
        <item name="android:textColorTertiary">#9E9E9E</item>
        <item name="android:textColorHint">#757575</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
    </style>
</resources>   