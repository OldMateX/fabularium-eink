<?xml version="1.0" encoding="utf-8"?>
<!--
    values-night/themes.xml
    Standard dark mode theme: black background, white text.
    (The e-ink variant lives in themes_eink.xml alongside this file.)
-->
<resources>

    <!-- Main app theme -->
    <style name="Theme.Fabularium" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window & popup backgrounds: black -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:popupBackground">#000000</item>

        <!-- Dialog theme override -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.Dialog</item>

        <!-- Surface colours: all black -->
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>

        <!-- ⚠️ Both are black — primary buttons will be invisible on black bg.
             Consider: colorPrimary=#FFFFFF, colorOnPrimary=#000000 -->
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#000000</item>
        <!-- Accent: white -->
        <item name="colorAccent">#FFFFFF</item>
    </style>

    <!-- Popup/dropdown overlay: white text on black -->
    <style name="ThemeOverlay.Fabularium.Popup" parent="ThemeOverlay.AppCompat">
        <item name="colorBackgroundFloating">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <!-- ⚠️ This is black — should be #FFFFFF for visible text on dark bg -->
        <item name="android:textColorPrimary">#000000</item>
        <!-- ⚠️ Dark grey on black is nearly invisible — try #CCCCCC -->
        <item name="android:textColorSecondary">#333333</item>
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
    </style>

</resources>   