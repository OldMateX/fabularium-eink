<?xml version="1.0" encoding="utf-8"?>
<!--
    values-night/themes_eink.xml
    E-ink theme (night mode): black background, white text.
    Dialogs override to white background, black text.
-->
<resources>

    <style name="Theme.Fabularium.EInk" parent="Theme.Fabularium.EInk.Base">

        <!-- Night colours: black bg, white text -->
        <item name="colorBackgroundFloating">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:popupBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#CCCCCC</item>

        <!-- ✅ CHANGED: was #000000 (black on black = invisible) -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <!-- ✅ CHANGED: was #333333 (dark grey on black = nearly invisible) -->
        <item name="android:textColorSecondary">#CCCCCC</item>

        <item name="colorPrimary">#000000</item>
        <!-- ✅ CHANGED: was #000000 (text ON black buttons was invisible) -->
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorAccent">#FFFFFF</item>

        <!-- Dialogs: use the e-ink dialog style (white bg, black text) -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>
    </style>

    <style name="Theme.Fabularium.EInk.Translucent" parent="Theme.Fabularium.EInk">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Dialog: white bg, black text (matches eink_dialog_background drawable) -->
    <style name="Theme.Fabularium.EInk.Dialog" parent="Theme.Fabularium.Dialog">
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnSurfaceVariant">#333333</item>
        <!-- ✅ ADDED: was missing — controls button text colour in dialogs -->
        <item name="colorPrimary">#000000</item>
        <!-- ✅ ADDED: was missing — AppCompat dialog buttons use colorAccent for text -->
        <item name="colorAccent">#000000</item>
    </style>

</resources>   