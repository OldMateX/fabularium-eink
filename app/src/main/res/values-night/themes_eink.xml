<?xml version="1.0" encoding="utf-8"?>
<!--
    E-ink theme (night mode): pure black/white, no animations, no shadows.
    Applied when pref_eink_mode is true and dark mode is on.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Fabularium.EInk" parent="Theme.Fabularium">

        <!-- === COLOURS === -->

        <!-- Background of the overflow popup (the 3-dot menu) -->
        <item name="colorBackgroundFloating">#000000</item>   

        <!-- Background of the entire app window -->
        <item name="android:windowBackground">#000000</item>

        <!-- Background of the settings list and any view that doesn't specify its own -->
        <item name="android:colorBackground">#000000</item>

        <!-- Background of the 3-dot overflow menu, dropdowns, tooltips -->
        <item name="android:popupBackground">#000000</item>

        <!-- Material3 "surface" — cards, dialogs, sheets, bottom bars -->
        <item name="colorSurface">#000000</item>

        <!-- Material3 nested surfaces — what the preference list items use as their bg -->
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>

        <!-- Main body text, titles, headings -->
        <item name="android:textColorPrimary">#FFFFFF</item>

        <!-- Subtitles, summaries, helper text -->
        <item name="android:textColorSecondary">#CCCCCC</item>

        <!-- Toolbar/app bar background + primary buttons -->
        <item name="colorPrimary">#FFFFFF</item>

        <!-- Text/icons ON the toolbar (black text on white bar) -->
        <item name="colorOnPrimary">#000000</item>

        <!-- Older Material accent — links, progress bars -->
        <item name="colorAccent">#FFFFFF</item>


        <!-- Text/icons on Material3 surfaces (preference items, cards, dialogs) -->
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- Text/icons on the app background -->
        <item name="colorOnBackground">#FFFFFF</item>

        <!-- Text/icons on surface-variant elements (chips, dividers, etc.) -->
        <item name="colorOnSurfaceVariant">#CCCCCC</item>   

        <!-- === KILL ANIMATIONS === -->

        <!-- Activity open/close transitions (slide, fade, zoom) -->
        <item name="android:windowAnimationStyle">@null</item>

        <!-- === KILL ELEVATION / SHADOWS === -->

        <!-- Drop shadow depth on all Material views -->
        <item name="android:elevation">0dp</item>

        <!-- Window-level shadow -->
        <item name="android:windowElevation" tools:targetApi="lollipop">0dp</item>

        <!-- === KILL BUTTON "LIFT" === -->

        <!-- The animation where a button rises up when pressed -->
        <item name="android:stateListAnimator">@null</item>

        <!-- === KILL RIPPLE === -->

        <!-- The faint flash when you tap something (white flash on black bg) -->
        <item name="android:colorControlHighlight">#33FFFFFF</item>

        <!-- What plays when you tap a list item, button, or tab. @null = nothing -->
        <item name="android:selectableItemBackground">@null</item>

        <!-- Same but for borderless items. @null = nothing -->
        <item name="android:selectableItemBackgroundBorderless">@null</item>

        <!-- === DIALOGS === -->

        <!-- Styling for pop-up dialogs (confirm boxes, long-press menus, etc.) -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>

        <!-- === POPUP MENUS (the 3-dot menu) === -->

        <item name="popupMenuStyle">@style/Widget.Fabularium.EInk.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Fabularium.EInk.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Fabularium.EInk.PopupMenu.Overflow</item>
        <item name="listPopupWindowStyle">@style/Widget.Fabularium.EInk.ListPopupWindow</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Fabularium.EInk.ListPopupWindow</item>   
    </style>   

    <!-- Transparent window variant (for splash screens, etc.) -->
    <style name="Theme.Fabularium.EInk.Translucent" parent="Theme.Fabularium.EInk">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
        Dialog-specific: kills the slide-up animation and forces black background.
        Applied to all dialogs including the nested PreferenceScreen sub-screens
        (when you tap "Windows", "Typography", etc. in settings).
    -->
    <style name="Theme.Fabularium.EInk.Dialog" parent="Theme.Fabularium.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:background">#000000</item>
        <item name="android:windowBackground">#000000</item>

        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#CCCCCC</item>
    </style>   

    <!-- E-ink popup menus (night): pure black, white text, white border -->
    <style name="Widget.Fabularium.EInk.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:background">#000000</item>
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
    </style>

    <style name="Widget.Fabularium.EInk.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:background">#000000</item>
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
    </style>

    <style name="Widget.Fabularium.EInk.ListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:background">#000000</item>
        <item name="android:popupBackground">@drawable/eink_popup_background</item>
        <item name="android:popupElevation" tools:targetApi="lollipop">0dp</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
    </style>   

</resources>   