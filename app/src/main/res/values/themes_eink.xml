<?xml version="1.0" encoding="utf-8"?>
<!--
    E-ink theme (day mode): pure white/black.
    Inherits all animation/ripple/elevation kills from Base.
-->
<resources>
    <style name="Theme.Fabularium.EInk" parent="Theme.Fabularium.EInk.Base">

        <!-- Day colours -->
        <item name="colorBackgroundFloating">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnSurfaceVariant">#333333</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#333333</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.EInk.Dialog</item>
    </style>

    <style name="Theme.Fabularium.EInk.Translucent" parent="Theme.Fabularium.EInk">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.Fabularium.EInk.Dialog" parent="Theme.Fabularium.Dialog">
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnSurfaceVariant">#333333</item>
    </style>
</resources>   