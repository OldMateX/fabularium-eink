<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fabularium" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:popupBackground">#FFFFFF</item>

        <!-- Toolbar: black bg, white text -->
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Accent (dialog buttons, etc.) -->
        <item name="colorAccent">#000000</item>

        <!-- Content area: explicitly pin all surface tokens
             so Material3 doesn't derive them from colorPrimary -->
        <item name="colorBackground">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">#424242</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#424242</item>
        <item name="android:textColorTertiary">#616161</item>
        <item name="android:textColorHint">#9E9E9E</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Fabularium.Dialog</item>
    </style>
</resources>   